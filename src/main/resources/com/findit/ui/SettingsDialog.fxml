<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.findit.ui.SettingsController"
      prefWidth="560" prefHeight="520"
      spacing="0" styleClass="root">

    <!-- Header -->
    <Label text="Options" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#d4d4d4; -fx-padding: 16 20 8 20;"/>

    <!-- Tabs -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color:#1e1e1e; -fx-tab-min-width:90;">

        <!-- ── General ── -->
        <Tab text="General">
            <ScrollPane fitToWidth="true" style="-fx-background-color:#1e1e1e; -fx-border-color: transparent;">
                <VBox spacing="14" style="-fx-padding:20;">

                    <Label text="Appearance" style="-fx-font-weight:bold; -fx-text-fill:#9cdcfe;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Theme:" prefWidth="130" style="-fx-text-fill:#d4d4d4;"/>
                        <ComboBox fx:id="themeCombo" prefWidth="160"/>
                    </HBox>
                    <CheckBox fx:id="showIconsCheck" text="Show file icons in results"
                              style="-fx-text-fill:#d4d4d4;"/>

                    <Separator/>
                    <Label text="Search" style="-fx-font-weight:bold; -fx-text-fill:#9cdcfe;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Max Results:" prefWidth="130" style="-fx-text-fill:#d4d4d4;"/>
                        <TextField fx:id="maxResultsField" prefWidth="120"/>
                    </HBox>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Debounce (ms):" prefWidth="130" style="-fx-text-fill:#d4d4d4;"/>
                        <TextField fx:id="debounceField" prefWidth="120"/>
                    </HBox>

                    <Separator/>
                    <Label text="File Watching" style="-fx-font-weight:bold; -fx-text-fill:#9cdcfe;"/>
                    <CheckBox fx:id="watcherEnabledCheck" text="Enable real-time file watching"
                              style="-fx-text-fill:#d4d4d4;"/>

                    <Separator/>
                    <Label text="Global Hotkey" style="-fx-font-weight:bold; -fx-text-fill:#9cdcfe;"/>
                    <CheckBox fx:id="hotkeyEnabledCheck" text="Enable global hotkey"
                              style="-fx-text-fill:#d4d4d4;"/>
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Key Combination:" prefWidth="130" style="-fx-text-fill:#d4d4d4;"/>
                        <TextField fx:id="hotkeyComboField" prefWidth="160"
                                   promptText="e.g. ALT+SPACE"/>
                        <Label text="(e.g. ALT+SPACE, CTRL+F1)"
                               style="-fx-text-fill:#888888; -fx-font-size:11px;"/>
                    </HBox>

                    <Separator/>
                    <CheckBox fx:id="startMinimizedCheck" text="Start minimized to system tray"
                              style="-fx-text-fill:#d4d4d4;"/>
                </VBox>
            </ScrollPane>
        </Tab>


        <!-- ── Exclusions ── -->
        <Tab text="Exclusions">
            <VBox spacing="10" style="-fx-padding:20;">
                <Label text="Excluded path prefixes (one per line):"
                       style="-fx-text-fill:#d4d4d4;"/>
                <TextArea fx:id="excludePathsArea" VBox.vgrow="ALWAYS"
                          prefRowCount="8" wrapText="false"
                          promptText="e.g. C:\Windows&#10;C:\Users\Someone\AppData"/>
                <HBox spacing="8">
                    <Button fx:id="addExcludeBtn"    text="+ Add"    styleClass="reindex-btn"/>
                    <Button fx:id="removeExcludeBtn" text="− Remove" styleClass="reindex-btn"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- ── About ── -->
        <Tab text="About">
            <VBox spacing="16" alignment="TOP_CENTER" style="-fx-padding:40 20;">
                <Label text="FindIT" style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#007acc;"/>
                <Label text="Version 1.0" style="-fx-font-size:13px; -fx-text-fill:#888888;"/>
                <Label text="High-performance desktop file search"
                       style="-fx-font-size:14px; -fx-text-fill:#d4d4d4;"/>
                <Hyperlink fx:id="githubLink" text="https://github.com/kalaiselvan-arumugam/FindIT"
                           style="-fx-text-fill:#4fc3f7;"/>
                <Label text="Inspired by Everything by voidtools"
                       style="-fx-font-size:12px; -fx-text-fill:#666666;"/>
                <Label text="Licensed under Apache License 2.0" style="-fx-font-size:12px; -fx-text-fill:#666666;"/>
            </VBox>
        </Tab>
    </TabPane>

    <!-- Footer Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding:12 20; -fx-background-color:#252526;">
        <Button fx:id="cancelBtn" text="Cancel" prefWidth="80"
                style="-fx-background-color:#3c3c3c; -fx-text-fill:#d4d4d4; -fx-border-color:#555555;"/>
        <Button fx:id="saveBtn" text="Save" prefWidth="80" defaultButton="true"
                styleClass="reindex-btn"/>
    </HBox>
</VBox>
